generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String         @default("")
  sortOrder   Int            @default(100)
  posts       PostCategory[]
}

// A post can have many categories and a category can have many posts.
model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Post {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  content     String         @db.Text
  excerpt     String         @default("")
  // Legacy: external/old cover URL. New covers are Media rows with isCover = true.
  coverUrl    String?
  status      PostStatus     @default(DRAFT)
  publishedAt DateTime?
  sourceUrl   String?
  externalId  String?        @unique
  views       Int            @default(0)
  isSample    Boolean        @default(false)
  categories  PostCategory[]
  tags        Tag[]
  media       Media[]
  viewLog     PostView[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
}

// Images are stored in PostgreSQL (BYTEA). `data` is omitted from every query by
// default (see src/lib/db.ts) and is only read by GET /api/media/[id].
// Rows created before this version have only `url` (no `data`); they keep working.
model Media {
  id       String    @id @default(cuid())
  postId   String
  type     MediaType @default(IMAGE)
  data     Bytes?
  mimeType String?
  filename String?
  size     Int       @default(0)
  width    Int?
  height   Int?
  alt      String    @default("")
  order    Int       @default(0)
  isCover  Boolean   @default(false)
  url      String? // legacy external / old /uploads URL
  createdAt DateTime @default(now())
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}

model PostView {
  id          String @id @default(cuid())
  postId      String
  visitorHash String
  day         String
  post        Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, visitorHash, day])
}
